+/* Perbaikan ukuran tampilan halaman Layanan */
+.layanan-card {
+  padding: 16px 20px;
+}
+
+.layanan-table {
+  table-layout: auto;
+  font-size: 13px;
+}
+
+.layanan-table th {
+  padding: 12px 10px;
+  font-size: 12px;
+  font-weight: 600;
+}
+
+.layanan-table td {
+  height: 42px;
+  padding: 7px 10px;
+  font-size: 13px;
+}
+
+.layanan-table th:nth-child(1),
+.layanan-table td:nth-child(1) {
+  width: 24%;
+}
+
+.layanan-table th:nth-child(2),
+.layanan-table td:nth-child(2) {
+  width: 17%;
+}
+
+.layanan-table th:nth-child(3),
+.layanan-table td:nth-child(3) {
+  width: 17%;
+}
+
+.layanan-table th:nth-child(4),
+.layanan-table td:nth-child(4) {
+  width: 10%;
+}
+
+.layanan-table th:nth-child(5),
+.layanan-table td:nth-child(5) {
+  width: 32%;
+}
+
+.layanan-name-input {
+  font-size: 13px;
+}
+
+.layanan-price-input,
+.layanan-hpp-input {
+  box-sizing: border-box;
+  width: 100px;
+  max-width: 100%;
+  height: 30px;
+  padding: 4px 7px;
+  font-size: 12px;
+}
+
+.layanan-table input[type="checkbox"] {
+  width: 16px;
+  height: 16px;
+}
+
+.layanan-actions {
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.layanan-table td.layanan-aksi button {
+  min-height: 30px;
+  margin: 0;
+  padding: 5px 9px;
+  font-size: 11px;
+}
+
+.tambah-layanan-card {
+  padding: 18px 20px;
+}
+
+.tambah-layanan-card h2 {
+  font-size: 18px;
+}
+
+.layanan-input-group label {
+  font-size: 12px;
+}
+
+.layanan-input-group input {
+  height: 36px;
+  font-size: 12px;
+}
+
+.layanan-submit {
+  width: auto;
+  min-width: 80px;
+  height: 34px;
+  padding: 0 14px;
+  font-size: 12px;
+}
+
+@media (max-width: 800px) {
+  .layanan-table {
+    min-width: 700px;
+  }
+}
